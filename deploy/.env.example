# Copy to deploy/.env and fill in. Never commit the copy. Compose reads it to
# fill in each service's settings; no service sees the whole file.
# Generate a password with: openssl rand -hex 24

# --- Database ---
# Postgres superuser, used only to create the two roles on first start.
TS_POSTGRES_PASSWORD=
# Passwords for ts_owner (migrations) and ts_app (the API). Set them before the
# first `up`: they are baked into the data volume then. Keep them URL-safe (hex).
TS_OWNER_PASSWORD=
TS_APP_PASSWORD=
# Compose builds TS_DATABASE_URL (ts_app) and TS_MIGRATE_DATABASE_URL (ts_owner)
# from the passwords above; the db is published on 127.0.0.1:5432 (keep it free).
# TS_DATABASE_URL=

# --- Where things listen (host networking: loopback only; keep it that way) ---
TS_HTTP_ADDR=127.0.0.1:3000
TS_STOREFRONT_HOST=127.0.0.1
TS_STOREFRONT_PORT=3001
TS_DASHBOARD_HOST=127.0.0.1
TS_DASHBOARD_PORT=3002
# How the storefront and dashboard reach the API.
TS_API_URL=http://127.0.0.1:3000/v1
# Peers allowed to set X-Real-IP: your reverse proxy, on this host.
TS_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# --- Public addresses (what browsers see, behind your reverse proxy) ---
TS_PUBLIC_URL=https://api.example.com
TS_DASHBOARD_ORIGIN=https://dashboard.example.com
TS_STOREFRONT_URL=https://tickets.example.com
# The dashboard's registrable domain, no scheme or port. Passkeys are bound to it.
TS_WEBAUTHN_RPID=example.com

# --- Secrets at rest ---
# base64 of 32 random bytes: openssl rand -base64 32
TS_SECRET_KEY=

# --- Payments ---
# direct: your own Stripe account, no platform fee. connect: Stripe Connect.
TS_PAYMENTS=direct
TS_STRIPE_SECRET_KEY=
TS_STRIPE_PUBLISHABLE_KEY=
TS_STRIPE_WEBHOOK_SECRET=
# Connect only (leave empty with TS_PAYMENTS=direct):
TS_STRIPE_CLIENT_ID=
# Leave unset with direct. With connect: basis points (default 200) and cents (default 50).
# TS_PLATFORM_FEE_BP=
# TS_PLATFORM_FEE_CENTS=

# --- Bot check (Cloudflare Turnstile) ---
# The API won't start without the secret. To try it with no check at all,
# uncomment the next line. That turns the bot check off entirely: trials only,
# never a public site.
# TS_ALLOW_NO_TURNSTILE=1
TS_TURNSTILE_SECRET=
TS_TURNSTILE_SITEKEY=
# Only change to point at a stand-in verifier.
# TS_TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# --- Mail: required for any TS_PUBLIC_URL that isn't http://localhost ---
# resend, smtp, or log (log sends nothing and only works on a local http URL).
TS_MAIL=smtp
TS_MAIL_FROM="Box Office <tickets@example.com>"
# Optional: where quota warnings go.
TS_MAIL_ALERT_TO=
# Resend:
TS_RESEND_API_KEY=
TS_RESEND_WEBHOOK_SECRET=
# TS_RESEND_API_URL=https://api.resend.com
# SMTP (TLS required; 465 is implicit TLS). Username and password go together.
TS_SMTP_HOST=smtp.example.com
TS_SMTP_PORT=587
TS_SMTP_USERNAME=
TS_SMTP_PASSWORD=
